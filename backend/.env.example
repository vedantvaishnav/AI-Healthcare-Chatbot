# Copy this file to .env and replace the placeholder with your actual Gemini API key.
GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY
# Optional: use GOOGLE_API_KEY as a fallback if you prefer that environment variable name.
# GOOGLE_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY
# Optional: override the Gemini model name.
# GEMINI_MODEL_NAME=models/gemini-2.5-flash
