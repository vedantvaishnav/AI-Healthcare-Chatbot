# Copy this file to .env and replace the placeholder with a valid Gemini API key.
# The current key in .env may be invalid or reported as leaked, which causes 403 PermissionDenied.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: use GOOGLE_API_KEY as a fallback if you prefer that environment variable name.
# GOOGLE_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY
# Optional: override the Gemini model name. Leave blank to use the default model used by the application.
# GEMINI_MODEL_NAME=models/gemini-2.5-flash
# Optional: override the GROQ model name. Leave blank to use the default model used by the application.