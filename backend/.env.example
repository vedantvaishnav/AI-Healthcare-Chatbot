# Copy this file to .env and replace the placeholder with a valid Groq API key.
# The current key in .env may be invalid or reported as leaked, which causes 403 PermissionDenied.
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the Groq model name. Leave blank to use the default model used by the application.
# GROQ_MODEL_NAME=llama-3.1-8b-instant

# Legacy Gemini compatibility only:
# GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY
# GEMINI_MODEL_NAME=models/gemini-2.5-flash
